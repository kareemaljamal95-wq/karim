# ---------------------------------------------------------------------------
# AI CEO platform configuration
#
# Copy to `.env` (repo root or server/) and fill in what you need. Every value
# here is read server-side only — nothing in this file is ever exposed to the
# browser. The platform runs fully in demo mode with none of it set.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Where the SQLite database and other runtime data live.
DATA_DIR=./data
# DATABASE_FILE=./data/ai-ceo.db

# --- Security --------------------------------------------------------------
# REQUIRED in production. Signs session tokens; changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# REQUIRED in production. Encrypts integration credentials at rest (AES-256-GCM).
# Changing it makes previously stored credentials unreadable — re-enter them.
APP_SECRET=change-me-to-a-different-long-random-string

# The admin account created on first run only. Change the password after signing in.
BOOTSTRAP_ADMIN_EMAIL=admin@ai-ceo.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2024

# Comma-separated list, or * to allow any origin.
CORS_ORIGIN=http://localhost:5173

# --- AI reasoning ----------------------------------------------------------
# Without a key the platform uses its deterministic rule engine instead, and
# labels every result accordingly. Scores are identical either way; only the
# written explanations and outreach copy change.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LLM_EFFORT=high

# --- Business discovery ----------------------------------------------------
# Without a key the Market Scout returns clearly-labelled demo businesses.
GOOGLE_PLACES_API_KEY=

# --- Behaviour -------------------------------------------------------------
# Demo mode is implied whenever no live discovery source is configured.
DEMO_MODE=true

# MASTER KILL-SWITCH for outbound messaging. Leave false unless you intend to
# deliver real messages. Even when true, a message is only dispatched if it has
# been approved by a human AND its channel integration is connected. Setting
# this to false overrides the in-app Settings toggle.
OUTBOUND_SENDING_ENABLED=false
