# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite
*.db
*.db-wal
*.db-shm

# The schema is source, not a database dump — the app cannot start without it.
!server/src/db/schema.sql

# Runtime data (SQLite database lives here)
data/

# Local environment / secrets
.env
.env.local
.env.*.local

